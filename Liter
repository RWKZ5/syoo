--!nonstrict
-- ============================================================
-- [ Aimbot + Box ESP — v3 Architecture ]
-- Pipeline: Filter → Collector → TargetSelector → PartSelector
--           → Prediction → Aimbot        |  ESP (independent)
-- ============================================================

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local Teams      = game:GetService("Teams")

local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- [ CONFIG ]
-- ============================================================
local Config = {
    AimbotEnabled      = true,
    ESPEnabled         = true,

    BulletSpeed        = 1000,
    Smoothness         = 0.35,
    FOV_Radius         = 150,

    PreferClosest      = true,   -- true → closest real distance; false → closest to screen center
    MaxTargetDist      = 500,
    SwitchThreshold    = 30,     -- studs: الجديد يجب أن يكون أقرب بهذا القدر على الأقل

    -- أوزان PartSelector
    NameWeight         = 0.4,
    ScreenWeight       = 0.6,

    -- PartSelector
    MaxAltParts        = 8,

    -- Rates
    TargetAcquireHz    = 20,     -- target acquisition معدّل
    VisibilityHz       = 12,     -- raycast per-part
}

local VIS_CACHE_TTL     = 1 / Config.VisibilityHz
local TARGET_ACQ_PERIOD = 1 / Config.TargetAcquireHz

-- ============================================================
-- [ UTIL ]
-- ============================================================
local function getCamera()
    return workspace.CurrentCamera
end

local function getScreenCenter()
    local v = getCamera().ViewportSize
    return Vector2.new(v.X * 0.5, v.Y * 0.5)
end

local function safeDt(dt) return math.max(dt, 1e-4) end
local function roundVec(v) return Vector3.new(
    math.floor(v.X * 10 + 0.5) / 10,
    math.floor(v.Y * 10 + 0.5) / 10,
    math.floor(v.Z * 10 + 0.5) / 10
) end

-- ============================================================
-- [ REGISTRY ]
-- ============================================================
local PlayerRegistry = {}

function PlayerRegistry.track(player, conn)
    PlayerRegistry[player] = PlayerRegistry[player] or { connections = {} }
    table.insert(PlayerRegistry[player].connections, conn)
end

function PlayerRegistry.clear(player)
    local e = PlayerRegistry[player]
    if not e then return end
    for _, c in ipairs(e.connections) do
        pcall(function() c:Disconnect() end)
    end
    PlayerRegistry[player] = nil
end

-- ============================================================
-- [ TEAMS CACHE — يُحدّث مرة واحدة ]
-- ============================================================
local TeamsCache = { hasMulti = false, lastUpdate = 0 }
local TEAMS_TTL = 1.0

local function refreshTeamsCache()
    local now = os.clock()
    if now - TeamsCache.lastUpdate < TEAMS_TTL then return end
    TeamsCache.hasMulti  = #Teams:GetTeams() > 1
    TeamsCache.lastUpdate = now
end

-- ============================================================
-- [ STAGE 1 — TargetFilter ]
-- ============================================================
local TargetFilter = {}

function TargetFilter.isValid(player)
    if not player or player == LocalPlayer or not player.Parent then return false end
    if not TeamsCache.hasMulti then return true end

    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return false
    end
    if player.TeamColor == LocalPlayer.TeamColor
       and LocalPlayer.TeamColor ~= BrickColor.new("Medium stone grey") then
        return false
    end
    return true
end

-- ============================================================
-- [ STAGE 2 — CandidateCollector  (FOV applied on HRP) ]
-- ============================================================
local Collector = {}

function Collector.collect()
    local cam    = getCamera()
    local myChar = LocalPlayer.Character
    local myHrp  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return {} end

    local center   = getScreenCenter()
    local out      = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if TargetFilter.isValid(player) then
            local char = player.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                          or char:FindFirstChild("Torso")
                if hum and hum.Health > 0 and hrp then
                    local realDist = (hrp.Position - myHrp.Position).Magnitude
                    if realDist <= Config.MaxTargetDist then
                        local sp, onScreen = cam:WorldToViewportPoint(hrp.Position)
                        if onScreen then
                            -- ✅ FOV يُطبّق على HRP
                            local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if screenDist <= Config.FOV_Radius then
                                table.insert(out, {
                                    player     = player,
                                    character  = char,
                                    hrp        = hrp,
                                    realDist   = realDist,
                                    screenDist = screenDist,
                                })
                            end
                        end
                    end
                end
            end
        end
    end
    return out
end

-- ============================================================
-- [ STAGE 3 — TargetSelector (PreferClosest + SwitchThreshold) ]
-- ============================================================
local TargetSelector = {}
local currentTarget = nil

function TargetSelector.pick(candidates)
    if #candidates == 0 then
        currentTarget = nil
        return nil
    end

    table.sort(candidates, function(a, b)
        if Config.PreferClosest then
            return a.realDist < b.realDist
        else
            return a.screenDist < b.screenDist
        end
    end)

    local best = candidates[1]

    -- منطق التبديل: أبقِ الحالي إذا الجديد ليس أقرب بـ SwitchThreshold
    if currentTarget and currentTarget ~= best.player then
        for _, c in ipairs(candidates) do
            if c.player == currentTarget then
                local metricBest  = Config.PreferClosest and best.realDist or best.screenDist
                local metricCurr  = Config.PreferClosest and c.realDist    or c.screenDist
                if metricBest > metricCurr - Config.SwitchThreshold then
                    best = c
                end
                break
            end
        end
    end

    currentTarget = best.player
    return best
end

function TargetSelector.getCurrent() return currentTarget end

-- ============================================================
-- [ STAGE 4 — PartSelector (priority-first, then alternatives) ]
-- ============================================================
local PartSelector = {}

local PRIORITY_NAMES = {
    Head             = 1.0,
    UpperTorso       = 0.7,
    Torso            = 0.7,
    HumanoidRootPart = 0.5,
    LowerTorso       = 0.5,
}

-- visibility cache: مفتاح مركّب لتجنّب نتائج قديمة
local visCache = {}

local function visKey(part, cameraPos, charPos)
    return string.format("%d|%.1f_%.1f_%.1f|%.1f_%.1f_%.1f",
        part:GetDebugId(),
        cameraPos.X, cameraPos.Y, cameraPos.Z,
        charPos.X, charPos.Y, charPos.Z)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function refreshRayFilter()
    local char = LocalPlayer.Character
    rayParams.FilterDescendantsInstances = char and {char} or {}
end

local function isVisible(part, character)
    if not part or not part.Parent or not character then return false end

    local cam     = getCamera()
    local camPos  = roundVec(cam.CFrame.Position)
    local charPos = roundVec(character:GetPivot().Position)
    local key     = visKey(part, camPos, charPos)

    local now = os.clock()
    local cached = visCache[key]
    if cached and now - cached.t < VIS_CACHE_TTL then
        return cached.v
    end

    refreshRayFilter()
    local result = workspace:Raycast(camPos, part.Position - camPos, rayParams)
    local v
    if not result then
        v = true
    else
        v = result.Instance:IsDescendantOf(character)
    end

    visCache[key] = { v = v, t = now }
    return v
end

-- ✅ فحص الأولوية أولًا — مضمون حتى مع MaxAltParts
function PartSelector.pick(character, center)
    if not character then return nil end

    -- 1) فحص الأجزاء ذات الأولوية أولًا
    for name in pairs(PRIORITY_NAMES) do
        local part = character:FindFirstChild(name)
        if part and isVisible(part, character) then
            -- نُرجع الأفضل ضمن الأولويات بالدرجة
            local best, bestScore = nil, -math.huge
            for n2, w in pairs(PRIORITY_NAMES) do
                local p2 = character:FindFirstChild(n2)
                if p2 and isVisible(p2, character) then
                    local sp, onScreen = getCamera():WorldToViewportPoint(p2.Position)
                    if onScreen then
                        local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        local screenW = 1 - math.clamp(sd / Config.FOV_Radius, 0, 1)
                        local score = w * Config.NameWeight + screenW * Config.ScreenWeight
                        if score > bestScore then
                            bestScore = score
                            best = p2
                        end
                    end
                end
            end
            if best then return best end
        end
    end

    -- 2) بدائل: جمع وفرز ثم فحص أعلى MaxAltParts
    local alts = {}
    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("BasePart") and not PRIORITY_NAMES[obj.Name] then
            local sp, onScreen = getCamera():WorldToViewportPoint(obj.Position)
            if onScreen then
                local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if sd <= Config.FOV_Radius then
                    table.insert(alts, { part = obj, sd = sd })
                end
            end
        end
    end
    table.sort(alts, function(a, b) return a.sd < b.sd end)

    for i = 1, math.min(#alts, Config.MaxAltParts) do
        local p = alts[i].part
        if isVisible(p, character) then return p end
    end
    return nil
end

-- ============================================================
-- [ STAGE 5 — Prediction ]
-- ============================================================
local Prediction = {}
local lastVel = {}

function Prediction.predict(player, part, dt)
    if not player or not part then return nil end
    local char = player.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return part.Position end

    local vel = part.AssemblyLinearVelocity
    if vel.Magnitude < 0.1 then vel = hrp.AssemblyLinearVelocity end

    local cam = getCamera()
    local dist        = (part.Position - cam.CFrame.Position).Magnitude
    local speed       = Config.BulletSpeed > 0 and Config.BulletSpeed or 1000
    local timeToReach = dist / speed

    local prev        = lastVel[player] or vel
    local accel       = (vel - prev) / safeDt(dt)
    lastVel[player]   = vel

    local CAP = 500
    if accel.Magnitude > CAP then accel = accel.Unit * CAP end

    return part.Position + vel * timeToReach + 0.5 * accel * (timeToReach ^ 2)
end

function Prediction.clear(player) lastVel[player] = nil end

-- ============================================================
-- [ STAGE 6 — Aimbot  (used only for Aim update each frame) ]
-- ============================================================
local Aimbot = {}
local activeTarget = nil        -- set by TargetAcquisition loop
local activePart   = nil
local lastAcquire  = 0

function Aimbot.setActiveTarget(player, part)
    activeTarget, activePart = player, part
end

function Aimbot.step(dt)
    if not Config.AimbotEnabled then return end
    if not activeTarget or not activePart then return end

    -- تحقق سريع من الحياة
    local char = activeTarget.Character
    if not char then activeTarget, activePart = nil, nil; return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        activeTarget, activePart = nil, nil
        return
    end

    local predicted = Prediction.predict(activeTarget, activePart, dt)
    if not predicted then return end

    local cam = getCamera()
    local a = math.clamp(Config.Smoothness, 0, 1)
    cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, predicted), a)
end

function Aimbot.clear() activeTarget, activePart = nil, nil end

-- ============================================================
-- [ TARGET ACQUISITION — منفصل تمامًا عن Aim update ]
-- ============================================================
local function runAcquire()
    local candidates = Collector.collect()
    local best = TargetSelector.pick(candidates)
    if best then
        local center = getScreenCenter()
        local part   = PartSelector.pick(best.character, center)
        if part then
            Aimbot.setActiveTarget(best.player, part)
        else
            Aimbot.clear()
        end
    else
        Aimbot.clear()
    end
end

