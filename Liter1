local FOVRenderer = {}
local fovGui = nil
local RING_IMAGE = "rbxassetid://5028857084"

local function buildGuiFOV()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local l = Instance.new("ImageLabel")
    l.Name = "FOV_Circle"
    l.BackgroundTransparency = 1
    l.Image = RING_IMAGE
    l.ImageColor3 = Color3.fromRGB(0, 255, 150)
    l.ImageTransparency = 0.15
    l.ZIndex = 0
    l.Parent = pg
    return l
end

function FOVRenderer.init()
    fovGui = buildGuiFOV()
end

function FOVRenderer.update()
    if not fovGui then return end
    local r = FOV_Radius
    fovGui.Size = UDim2.new(0, r * 2, 0, r * 2)
    fovGui.Position = UDim2.new(0.5, -r, 0.5, -r)
    fovGui.Visible = AimbotEnabled
end

function FOVRenderer.destroy()
    if fovGui then pcall(function() fovGui:Destroy() end); fovGui = nil end
end

-- ============================================================
-- [ ESP — Bounding Box Projection ]
-- ============================================================
local ESP = {}
ESP.active = {}

local BOX_CORNERS = {
    Vector3.new(-0.5,-0.5,-0.5), Vector3.new( 0.5,-0.5,-0.5),
    Vector3.new(-0.5, 0.5,-0.5), Vector3.new( 0.5, 0.5,-0.5),
    Vector3.new(-0.5,-0.5, 0.5), Vector3.new( 0.5,-0.5, 0.5),
    Vector3.new(-0.5, 0.5, 0.5), Vector3.new( 0.5, 0.5, 0.5),
}

local function getBoundingBox(character)
    local ok, cf, size = pcall(function() return character:GetBoundingBox() end)
    if ok and cf and size then return cf, size end
    return nil, nil
end

local function projectBox(character, cam)
    local cf, size = getBoundingBox(character)
    if not cf or not size then return nil end

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local anyOnScreen = false

    for _, c in ipairs(BOX_CORNERS) do
        local world = cf:PointToWorldSpace(c * size)
        local sp, onScreen = cam:WorldToViewportPoint(world)
        if onScreen and sp.Z > 0 then
            anyOnScreen = true
            if sp.X < minX then minX = sp.X end
            if sp.Y < minY then minY = sp.Y end
            if sp.X > maxX then maxX = sp.X end
            if sp.Y > maxY then maxY = sp.Y end
        end
    end

    if not anyOnScreen then return nil end
    return minX, minY, maxX, maxY
end

local function buildESP()
    local gui = Instance.new("ScreenGui")
    gui.Name = "ESP_Layer"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame", gui)
    frame.BackgroundTransparency = 1

    local stroke = Instance.new("UIStroke", frame)
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(255, 50, 50)

    local distLabel = Instance.new("TextLabel", gui)
    distLabel.BackgroundTransparency = 1
    distLabel.TextColor3 = Color3.fromRGB(255,255,255)
    distLabel.TextStrokeTransparency = 0
    distLabel.Font = Enum.Font.GothamBold
    distLabel.TextSize = 11
    distLabel.Text = "0m"

    return gui, frame, stroke, distLabel
end

local function destroyESP(player)
    local e = ESP.active[player]
    if not e then return end
    if e.conn then e.conn:Disconnect() end
    if e.gui then e.gui:Destroy() end
    ESP.active[player] = nil
end

ESP.destroy = destroyESP

function ESP.create(player)
    if ESP.active[player] then return end
    if not Config.ESPEnabled then return end

    local gui, frame, stroke, distLabel = buildESP()

    local conn = RunService.RenderStepped:Connect(function()
        if not Config.ESPEnabled then
            gui.Enabled = false
            return
        end
        gui.Enabled = true

        if not player.Parent then destroyESP(player); return end
        if not isValidTarget(player) then destroyESP(player); return end

        local char = player.Character
        local myChar = LocalPlayer.Character
        if not char or not myChar then
            frame.Visible = false; distLabel.Visible = false; return
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not myHrp or not hum or hum.Health <= 0 then
            frame.Visible = false; distLabel.Visible = false; return
        end

        local cam = getCamera()
        if not cam then return end

        local minX, minY, maxX, maxY = projectBox(char, cam)
        if not minX then
            frame.Visible = false; distLabel.Visible = false; return
        end

        frame.Visible = true
        frame.Position = UDim2.new(0, minX, 0, minY)
        frame.Size     = UDim2.new(0, maxX - minX, 0, maxY - minY)

        distLabel.Visible = true
        distLabel.Position = UDim2.new(0, minX, 0, maxY + 2)
        distLabel.Size     = UDim2.new(0, maxX - minX, 0, 14)

        local d = math.floor((hrp.Position - myHrp.Position).Magnitude)
        distLabel.Text = d .. "m"

        local head = char:FindFirstChild("Head")
        if head and isPartVisible(head) then
            stroke.Color = Color3.fromRGB(0, 255, 100)
        else
            stroke.Color = Color3.fromRGB(255, 50, 50)
        end
    end)

    ESP.active[player] = { gui = gui, conn = conn }
end

function ESP.setEnabled(v)
    Config.ESPEnabled = v
    for _, e in pairs(ESP.active) do
        if e.gui then e.gui.Enabled = v end
    end
    if v then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and isValidTarget(p) then ESP.create(p) end
        end
    end
end

-- ============================================================
-- [ WIRING ]
-- ============================================================
local function onPlayerAdded(p)
    if p == LocalPlayer then return end
    if isValidTarget(p) then ESP.create(p) end
    local c = p.CharacterAdded:Connect(function()
        task.wait(0.25)
        if Config.ESPEnabled and isValidTarget(p) then ESP.create(p) end
    end)
    PlayerRegistry.track(p, c)
end

local function onPlayerRemoving(p)
    ESP.destroy(p)
    lastVelocities[p] = nil
    PlayerRegistry.clear(p)
end

for _, p in ipairs(Players:GetPlayers()) do onPlayerAdded(p) end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

